# Copy to .env.local and fill in. Never commit real values.

# Public site URL (https only is used for canonical/sitemap; otherwise the Netlify URL is used)
NEXT_PUBLIC_APP_URL=https://findthetempo.netlify.app

# Google Analytics 4 measurement ID. Loads only in production and only after cookie consent.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Which upstream reads the screenshot: vertex | gemini | openrouter
OCR_PROVIDER=openrouter

# openrouter
OPENROUTER_API_KEY=
QWEN_MODEL=

# gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# vertex (service account with only the Vertex AI User role)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_SERVICE_ACCOUNT_JSON=

# BPM lookup (GetSongBPM)
GETSONGBPM_API_KEY=
